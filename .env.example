# ============================================================
# PolicyDiff — Environment Variables
# Copy this to .env and fill in your real values.
# ============================================================

# ── ClickHouse ──────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=policydiff

# ── Engineer A — Ingestion ──────────────────────────────────
NIMBLE_API_KEY=your_nimble_api_key_here
POLL_INTERVAL_MINUTES=30
WATCHLIST_PATH=./config/watchlist.yaml

# ── Engineer B — Classifier ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
SENSO_API_KEY=your_senso_api_key_here
SENSO_ORG_HANDLE=policydiff
DD_API_KEY=your_datadog_api_key_here
DD_SITE=us5.datadoghq.com
DD_LLMOBS_ENABLED=1
DD_LLMOBS_AGENTLESS_ENABLED=1
DD_LLMOBS_ML_APP=policydiff
CLASSIFIER_BATCH_SIZE=5
CLASSIFIER_POLL_INTERVAL_SECONDS=60

# ── Engineer C — API Dashboard ───────────────────────────────
FRONTEND_REFRESH_INTERVAL_SECONDS=10

# Optional x402 PDF export (set ENABLE_X402=true to activate)
ENABLE_X402=false
WALLET_ADDRESS=0x0000000000000000000000000000000000000000
X402_PRICE_USDC=2000000

# Optional Luminai webhook routing (set ENABLE_LUMINAI=true to activate)
ENABLE_LUMINAI=false
# Use https://httpbin.org/post for demo, replace with real Luminai URL in prod
LUMINAI_WEBHOOK_URL=https://httpbin.org/post

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8003
NEXT_PUBLIC_REFRESH_INTERVAL_SECONDS=10
