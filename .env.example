# ============================================================
# PolicyDiff — .env.example (centralised)
# Copy this to .env and fill in real values.
# All services (A, B, C) read from this single file.
# ============================================================

# ── ClickHouse ────────────────────────────────────────────────
# Use cloud URL for team-shared instance, localhost for local dev
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=policydiff
# Set to true for cloud ClickHouse (AWS/GCP hosted)
CLICKHOUSE_SECURE=false
CLICKHOUSE_VERIFY=true

# ── Nimble Web Scraping (Engineer A — Ingestion) ──────────────
NIMBLE_API_KEY=your_nimble_api_key_here
NIMBLE_API_URL=https://sdk.nimbleway.com/v1/extract
NIMBLE_REQUEST_TIMEOUT_SECONDS=105
NIMBLE_HTML_EXTRACT_TIMEOUT_SECONDS=45
NIMBLE_PDF_EXTRACT_TIMEOUT_SECONDS=90
NIMBLE_MAX_RETRIES=3
NIMBLE_RETRY_BACKOFF_SECONDS=2.0
POLL_INTERVAL_MINUTES=30
WATCHLIST_PATH=./config/watchlist.yaml

# ── Gemini AI (Engineer B — Classifier) ───────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended: gemma-4-26b-a4b-it (1,500 RPD free tier)
# Avoid: gemini-2.5-flash (only 20 RPD on free tier)
GEMINI_MODEL=gemma-4-26b-a4b-it

# ── Senso / cited.md evidence briefs (Engineer B) ─────────────
SENSO_API_KEY=your_senso_api_key_here
SENSO_ORG_HANDLE=policydiff

# ── Datadog LLM Observability (Engineer B) ────────────────────
DD_API_KEY=your_datadog_api_key_here
DD_SITE=us5.datadoghq.com
DD_LLMOBS_ENABLED=1
DD_LLMOBS_AGENTLESS_ENABLED=1
DD_LLMOBS_ML_APP=policydiff

# ── Classifier behaviour (Engineer B) ─────────────────────────
CLASSIFIER_BATCH_SIZE=5
CLASSIFIER_POLL_INTERVAL_SECONDS=60
POLICY_CPT_MAP_PATH=./config/policy_cpt_map.yaml

# ── Service URLs (inter-service communication) ─────────────────
INGESTION_SERVICE_URL=http://localhost:8001
CLASSIFIER_SERVICE_URL=http://localhost:8002
DASHBOARD_API_URL=http://localhost:8003

# ── Dashboard frontend (Engineer C) ───────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8003
NEXT_PUBLIC_REFRESH_INTERVAL_SECONDS=10

# ── Optional: x402 PDF export ─────────────────────────────────
ENABLE_X402=false
WALLET_ADDRESS=0x0000000000000000000000000000000000000000
X402_PRICE_USDC=2000000

# ── Optional: Luminai alert routing ───────────────────────────
ENABLE_LUMINAI=false
LUMINAI_WEBHOOK_URL=https://httpbin.org/post
