# ──────────────────────────────────────────────────────────
# PolicyDiff — classifier-service environment variables
# Copy to .env and fill in real values before running.
# ──────────────────────────────────────────────────────────

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=policydiff

# Gemini (required)
GEMINI_API_KEY=AIzaSyDsD1CE0HskHMz-K7tIW6GCd8YhQje0ll8
GEMINI_MODEL=gemini-2.0-flash

# Senso/cited.md (required for full demo)
SENSO_API_KEY=tgr_C3IJisVvrae9ja2EeJsrcCNExzfOfoi0YpJ1A4Q-bBA
SENSO_ORG_HANDLE=policydiff

# Datadog LLM Observability (required)
DD_API_KEY=your_datadog_api_key_here
DD_SITE=datadoghq.com
DD_LLMOBS_ENABLED=1
DD_LLMOBS_ML_APP=policydiff

# Classifier behaviour
CLASSIFIER_BATCH_SIZE=5
# Use 10 for demo, 60 for production
CLASSIFIER_POLL_INTERVAL_SECONDS=60

# Paths (defaults point to repo-relative locations)
POLICY_CPT_MAP_PATH=./config/policy_cpt_map.yaml
